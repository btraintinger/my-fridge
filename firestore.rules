rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read/write their own fridges
    match /fridges/{fridgeId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null &&
      (resource.data.userId == request.auth.uid ||
      (resource.data.sharedWithEmails != null &&
       request.auth.token.email in resource.data.sharedWithEmails)
      );

      // Allow access to items within a fridge
      match /items/{itemId} {
        // Check if user is owner or has shared access to parent fridge
        allow read, write: if request.auth != null && (
          get(/databases/$(database)/documents/fridges/$(fridgeId)).data.userId == request.auth.uid ||
          (get(/databases/$(database)/documents/fridges/$(fridgeId)).data.sharedWithEmails != null &&
           request.auth.token.email in get(/databases/$(database)/documents/fridges/$(fridgeId)).data.sharedWithEmails)
        );
      }

      // Shopping list for this specific fridge
      match /shopping_list/{itemId} {
        allow read, write: if request.auth != null && (
          get(/databases/$(database)/documents/fridges/$(fridgeId)).data.userId == request.auth.uid ||
          (get(/databases/$(database)/documents/fridges/$(fridgeId)).data.sharedWithEmails != null &&
           request.auth.token.email in get(/databases/$(database)/documents/fridges/$(fridgeId)).data.sharedWithEmails)
        );
      }
    }

    // User preferences
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // FCM device tokens — the user owns and manages their own tokens.
    // Rules do NOT recurse from users/{userId} so this explicit block is required.
    match /users/{userId}/fcm_tokens/{tokenId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Global products cache. Any authenticated user can populate it on scan,
    // but entries can't be deleted (vandalism) and the document's barcode
    // must match the doc id.
    match /products/{barcode} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.barcode == barcode;
      allow delete: if false;
    }
  }
}
